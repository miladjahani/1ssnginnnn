# Server configuration
PORT=8000
PUBLIC_BASE_URL=https://your-domain.up.railway.app
DEFAULT_DOMAIN=your-domain.com
DEFAULT_PATH=/
LOG_LEVEL=INFO

# Database configuration (embedded SQLite engine)
# Leave DATABASE_URL unset to let the service auto-select: /data/miliconfig.db when a
# Railway Volume is mounted at /data, otherwise ./miliconfig.db (ephemeral on Railway).
# DATABASE_URL=sqlite:///./miliconfig.db
# DATABASE_URL=sqlite:////data/miliconfig.db

# Security Secrets (Must be changed in production!)
SECRET_KEY=change_me_to_a_random_64_character_hex_string_for_production
JWT_SECRET=change_me_to_a_random_64_character_hex_string_for_jwt_session
SUBSCRIPTION_SECRET=change_me_to_a_random_64_character_hex_string_for_subs

# Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_secure_admin_password_min_12_chars

# Protocol & Network Settings
ENABLE_VLESS=true
ENABLE_TROJAN=true
ENABLE_XHTTP=true
ENABLE_SHADOWSOCKS=true
SS_PORT=8388
SS_BIND_HOST=0.0.0.0
SS_DEFAULT_METHOD=chacha20-ietf-poly1305
SS_DEFAULT_PASSWORD=change_me_to_a_secure_ss_password
# Public ShadowSocks endpoint (required on Railway unless a TCP proxy is enabled;
# RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT are used automatically when present)
# SS_PUBLIC_HOST=interchange.proxy.rlwy.net
# SS_PUBLIC_PORT=19123

# Outbound Proxy & Routing Settings
OUTBOUND_MODE=
OUTBOUND_PROXY=
DNS_SERVERS=1.1.1.1,8.8.8.8,https://223.5.5.5/dns-query
